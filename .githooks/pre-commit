#!/bin/sh
# Blocks commits containing secrets. Activate once per clone with:
#   git config core.hooksPath .githooks
# Requires gitleaks (https://github.com/gitleaks/gitleaks): brew install gitleaks

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed — skipping secret scan" >&2
    echo "            install it (brew install gitleaks) to enable scanning" >&2
    exit 0
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
